# Copy to .env for local development. NEVER commit .env — it is gitignored.
#
# In deployed environments these are set in the platform's secrets store
# (Vercel project environment variables / Supabase Edge Function secrets),
# not in a file. Edge functions can also read them from the app_secrets table,
# which is what lets an operator rotate a key with SQL access alone.
#
# Values below are placeholders. Never paste a real key into this file.

# ─── Supabase (public — these ship to the browser by design) ───────────────
NEXT_PUBLIC_SUPABASE_PROJECT_ID=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ─── Server-only ───────────────────────────────────────────────────────────
# Never exposed to the browser. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── AI model providers ────────────────────────────────────────────────────
# Which MODEL answers is configuration (app_settings.model_control_settings,
# editable in Admin → AI Models). The KEY is a secret and lives only here or
# in the platform's secrets store — it is referenced by name, never inlined.
#
# If a key has ever been pasted into a chat, a commit, a doc, or a ticket,
# treat it as compromised and rotate it in the provider console. Moving a
# leaked key into a secrets store does not un-leak it.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
